# Relaxed yamllint config for GitHub Actions and config YAML.
# GitHub Actions workflows do not require a "---" document start and commonly
# use unquoted truthy keys (e.g. "on:"). We relax those stylistic rules while
# keeping structural checks (indentation, trailing spaces, newlines).
extends: default

rules:
  document-start: disable
  truthy:
    level: warning
  line-length:
    max: 200
    level: warning
  comments:
    require-starting-space: true
    min-spaces-from-content: 2
  comments-indentation: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
